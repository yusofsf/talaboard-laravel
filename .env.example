APP_NAME="آبشده صفرپور"
APP_TIMEZONE=Asia/Tehran
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
SEO_URL=http://localhost
SEO_FORCE_HTTPS=false
APP_LOCALE=fa

# مقصد واریز بانکی برای درخواست افزایش موجودی کیف پول
DEPOSIT_ACCOUNT_NUMBER=7604343793
DEPOSIT_IBAN=IR89-0120-0100-0000-7604-3437-93
DEPOSIT_ACCOUNT_HOLDER="محمود صفرپور"

# Shared secret used only between the website and the Telegram bot.
TELEGRAM_LINK_API_TOKEN=
TELEGRAM_MEMBERSHIP_URL=${APP_URL}/membership

# API قیمت لحظه‌ای — برای GET /api/v1/prices از HTTP Basic Auth استفاده می‌شود.
# برای تولید سکرت: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
PRICE_API_USERNAME=
PRICE_API_SECRET=

LOG_CHANNEL=single
LOG_LEVEL=debug
# گزارش فعالیت (سیستم لاگ) — تعداد روز نگهداری فایل‌های storage/logs/activity-*.log
ACTIVITY_LOG_DAYS=90

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/shop.db

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ادمین اصلی (اولین ورود با این شماره، ادمین می‌شود)
ADMIN_PHONE=09xxxxxxxxx

# کاوه‌نگار پیامک (اختیاری)
# برای غیرفعال‌کردن کامل ارسال پیامک (بدون حذف کلید API، برای فعال‌سازی سریع بعداً) روی false بگذارید.
SMS_ENABLED=true
SMS_OTP_ENABLED=true
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=verify
KAVENEGAR_RESET_TEMPLATE=
TWO_FA_ENABLED=false

# کد تأیید پشتیبان — وقتی پیامک نمی‌رسد با این کد می‌توان تأیید کرد.
# ⚠️ هشدار امنیتی: با این کد می‌توان رمز هر حساب (از جمله ادمین) را از مسیر
# «فراموشی رمز» بازنشانی کرد. حتماً خالی بگذارید یا یک رشته‌ی بلند و تصادفی
# قرار دهید (نه چیزی مثل 000000). پیش‌فرض = غیرفعال.

# تالالند — قیمت طلا
TALALAND_API_BASE=https://api.talaland.net/api
TALALAND_USERNAME=your-reseller-id
TALALAND_TOKEN=your-api-key
MITHQAL_GRAMS=4.3318
# درصد اختلاف خرید/فروش از قیمت میانی برای طلا و نقره (مثلاً 0.01 = 1%)
# فروش = میانی × (1+GOLD_FACTOR)   |   خرید = میانی × (1-GOLD_FACTOR)
GOLD_FACTOR=0

# دلار — آلان‌چند، سپس TGJU به‌عنوان fallback
DOLLAR_HOME_URL=https://alanchand.com/
TGJU_DOLLAR_URL=https://www.tgju.org/profile/price_dollar_rl

# انس طلا — آلان‌چند، سپس TGJU و در نهایت Yahoo Finance
GOLD_OUNCE_SYMBOL=GC=F
DOLLAR_GOLD_URL=https://alanchand.com/gold-price
TGJU_GOLD_OUNCE_URL=https://www.tgju.org/profile/ons

# انس نقره — جدیدترین ردیف جدول «شاخص در روز جاری» TGJU
TGJU_SILVER_URL=https://www.tgju.org/profile/silver/today

# دیتابیس ربات نقره (sachmebot_laravel) — فقط خواندنی
SILVER_DB_PATH=/home/USERNAME/sachmebot_laravel/database/database.sqlite

# shop.db نسخه‌ی قبلی Flask — فقط برای دستور import:flask-shop (یک‌بار مصرف)
FLASK_SHOP_DB_PATH=/home/USERNAME/talaboard/shop.db

# مدت کش قیمت (ثانیه) — برای اینکه هر عکس فوری ۱۰ ثانیه‌ای واقعاً از منبع بگیرد، ≤ ۱۰ باشد
CACHE_TTL=10

# تعداد ثانیه بین رفرش‌های تابلوی قیمت در مرورگر — هماهنگ با عکس فوری ۱۰ ثانیه‌ای
REFRESH_SECONDS=10
